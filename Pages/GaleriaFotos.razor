@page "/galeriafotos"

<section class="page-banner">
    <div class="container">
        <h1 class="page-title">Galeria de Fotos</h1>
        <p class="page-subtitle">Casamentos, recepções, festas, apresentações e momentos da trajetória musical.</p>
    </div>
</section>

<div class="container">
    <div class="modern-container">
        <div class="row mb-4">
            <div class="col-12 text-center">
                <p class="text-muted mb-0">A galeria final será organizada por contexto, não apenas por data. As imagens abaixo preservam o acervo atual enquanto a curadoria 2026 é concluída.</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card-modern p-3 h-100">
                    <img src="/images/galerry/foto 1.jpg" class="img-fluid rounded mb-3" alt="Lincon Class em apresentação musical" />
                    <h5>Performance ao vivo</h5>
                    <p class="text-muted mb-0">Imagem-base do acervo atual. Será substituída apenas quando houver uma foto superior para a mesma função.</p>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card-modern p-4 h-100 d-flex flex-column justify-content-center">
                    <h5>Curadoria 2026</h5>
                    <p class="text-muted">A nova biblioteca será distribuída entre cerimônias, recepções, Sax Live, eventos corporativos, formações e trajetória artística.</p>
                    <p class="mb-0">O objetivo é mostrar contexto real de contratação, variedade de palco e consistência profissional — sem preencher a página com imagens repetidas.</p>
                </div>
            </div>
        </div>

        <div class="row g-3 mt-2">
            @foreach (var categoria in Categorias)
            {
                <div class="col-md-4 col-sm-6">
                    <div class="card-modern p-4 h-100">
                        <h6 class="mb-2">@categoria.Titulo</h6>
                        <p class="text-muted small mb-0">@categoria.Descricao</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private readonly (string Titulo, string Descricao)[] Categorias =
    {
        ("Cerimônias", "Entradas, momentos solenes e formações para casamento."),
        ("Recepções", "Música ao vivo na chegada, coquetéis e jantares."),
        ("Sax Live", "Pista, DJ e performances de maior energia."),
        ("Eventos Corporativos", "Recepções, inaugurações e confraternizações."),
        ("Celebrações", "Aniversários, 15 anos, homenagens e festas particulares."),
        ("Trajetória", "Orquestras, palcos, imprensa e registros históricos relevantes.")
    };
}
