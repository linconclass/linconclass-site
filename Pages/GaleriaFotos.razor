@page "/galeriafotos"
<PageTitle>Galeria de Fotos | Lincon Class</PageTitle>
<HeadContent>
    <meta name="description" content="Galeria de Lincon Class com registros de apresentações, casamentos, recepções, Sax Live, eventos e trajetória musical." />
    <link rel="canonical" href="https://linconclass.com.br/galeriafotos" />
</HeadContent>

<section class="page-banner">
    <div class="container">
        <span class="eyebrow">Galeria</span>
        <h1 class="page-title">Fotos</h1>
        <p class="page-subtitle">Casamentos, recepções, festas, apresentações e momentos da trajetória musical.</p>
    </div>
</section>

<div class="container">
    <div class="modern-container">
        <div class="row mb-4">
            <div class="col-12 text-center">
                <p class="text-muted mb-0">A biblioteca é organizada por contexto para mostrar como a música funciona em diferentes tipos e momentos de evento.</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card-modern p-3 h-100">
                    <img src="/images/galerry/foto 1.jpg" class="img-fluid rounded mb-3" alt="Lincon Class em apresentação musical" loading="lazy" />
                    <h2 class="h5">Performance ao vivo</h2>
                    <p class="text-muted mb-0">Registro do acervo atual. A seleção 2026 será ampliada com fotografias reais de diferentes contextos.</p>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card-modern p-4 h-100 d-flex flex-column justify-content-center">
                    <span class="eyebrow text-dark">Curadoria 2026</span>
                    <h2 class="h5">Uma galeria com função comercial</h2>
                    <p class="text-muted">A biblioteca será distribuída entre cerimônias, recepções, Sax Live, eventos corporativos, formações e trajetória artística.</p>
                    <p class="mb-0">A prioridade é contexto real, variedade e consistência profissional — não quantidade de imagens.</p>
                </div>
            </div>
        </div>

        <div class="row g-3 mt-2">
            @foreach (var categoria in Categorias)
            {
                <div class="col-md-4 col-sm-6">
                    <div class="card-modern p-4 h-100">
                        <h3 class="h6 mb-2">@categoria.Titulo</h3>
                        <p class="text-muted small mb-0">@categoria.Descricao</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private readonly (string Titulo, string Descricao)[] Categorias =
    {
        ("Cerimônias", "Entradas, momentos solenes e formações para casamento."),
        ("Recepções", "Música ao vivo na chegada, coquetéis e jantares."),
        ("Sax Live", "Pista, DJ e performances de maior energia."),
        ("Eventos Corporativos", "Recepções, inaugurações e confraternizações."),
        ("Celebrações", "Aniversários, 15 anos, homenagens e festas particulares."),
        ("Trajetória", "Orquestras, palcos, imprensa e registros históricos relevantes.")
    };
}
