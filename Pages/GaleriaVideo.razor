@page "/galeriavideos"
<PageTitle>Vídeos | Lincon Class</PageTitle>
<HeadContent>
    <meta name="description" content="Vídeos de Lincon Class em cerimônias, recepções, Sax Live, eventos corporativos, formações e apresentações musicais." />
    <link rel="canonical" href="https://linconclass.com.br/galeriavideos" />
</HeadContent>

<section class="page-banner">
    <div class="container">
        <span class="eyebrow">Vídeos</span>
        <h1 class="page-title">Performances reais por experiência</h1>
        <p class="page-subtitle">A seleção prioriza contexto, qualidade de áudio e capacidade de mostrar a experiência do evento.</p>
    </div>
</section>

<div class="container">
    <div class="modern-container">
        <div class="alert alert-light border mb-4">
            <strong>Curadoria em andamento.</strong> Os embeds genéricos do site antigo foram removidos. Só serão publicados vídeos reais, identificados e adequados à função comercial da página.
        </div>

        <div class="row g-3">
            @foreach (var categoria in Categorias)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="video-card-compact card-modern p-4 h-100">
                        <div class="ratio ratio-16x9 bg-dark rounded mb-3 d-flex align-items-center justify-content-center" aria-hidden="true">
                            <i class="fas fa-play-circle fa-3x text-white-50"></i>
                        </div>
                        <h2 class="h6 mb-1">@categoria.Titulo</h2>
                        <p class="text-muted mb-0 small">@categoria.Descricao</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private readonly (string Titulo, string Descricao)[] Categorias =
    {
        ("Cerimônia", "Entrada, momentos solenes e repertório personalizado."),
        ("Recepção", "Sax ao vivo em clima elegante e integrado ao ambiente."),
        ("Sax Live", "Performance de pista e interação com DJ."),
        ("Corporativo", "Apresentações em recepções, coquetéis e ações de marca."),
        ("Formações", "Duo, trio, quarteto e outras combinações musicais."),
        ("Trajetória", "Shows, orquestras e registros artísticos relevantes.")
    };
}
